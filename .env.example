# =====================================================================
# 0Media Digital Signage — Plantilla de Variables de Entorno (.env.example)
# =====================================================================
# NOTA: Este archivo es una plantilla vacía para despliegue.
# No contiene contraseñas, claves ni datos reales.

# ----------------- 1. RED Y PUERTOS -----------------
PORT=3000
HOST=0.0.0.0
LOCAL_IP=

# ----------------- 2. DOMINIO PÚBLICO Y SSL/HTTPS (PRODUCCIÓN) -----------------
# Define la URL pública HTTPS de tu servidor (ej. https://signage.tuempresa.com)
PUBLIC_URL=
NODE_ENV=production

# ----------------- 3. SEGURIDAD Y ACCESO ADMINISTRADOR -----------------
# Configura el usuario y una contraseña robusta para proteger el panel web
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# Habilitar autenticación obligatoria en el panel (true | false)
AUTH_ENABLED=true

# Clave secreta aleatoria para cifrado de sesiones en producción
SESSION_SECRET=

# Token de integración opcional para llamadas directas por API
ADMIN_SECRET=

# ----------------- 4. ALMACENAMIENTO MULTIMEDIA (CLOUD STORAGE / S3 / R2) -----------------
# 'local' guarda en disco del servidor. 's3' transfiere a Cloudflare R2 / AWS S3
STORAGE_DRIVER=local

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_DOMAIN=
