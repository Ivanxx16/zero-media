# =====================================================================
# 0Media Digital Signage — Plantilla de Variables de Entorno (.env.example)
# =====================================================================
# NOTA: Este archivo es una plantilla vacía para despliegue.
# No contiene contraseñas, claves ni datos reales.

# ----------------- 1. RED Y PUERTOS -----------------
PORT=3000
HOST=0.0.0.0
LOCAL_IP=

# ----------------- 2. DOMINIO PÚBLICO Y SSL/HTTPS (PRODUCCIÓN) -----------------
PUBLIC_URL=
NODE_ENV=production

# ----------------- 3. SEGURIDAD Y ACCESO ADMINISTRADOR -----------------
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
AUTH_ENABLED=true
SESSION_SECRET=admin123
ADMIN_SECRET=admin123

# ----------------- 4. ALMACENAMIENTO MULTIMEDIA (CLOUD STORAGE / S3 / R2) -----------------
STORAGE_DRIVER=local

S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_DOMAIN=
